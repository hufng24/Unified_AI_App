# Native/runtime only. Never use VITE_ for credentials.
# pnpm dev creates a random development token and supplies it to both processes.
UAI_API_BASE=http://127.0.0.1:8787
UAI_API_PORT=8787
# UAI_GATEWAY_TOKEN=replace-with-a-long-random-development-token
# SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
# Production auth/account/sync onboarding is not shipped in Foundation Alpha.
