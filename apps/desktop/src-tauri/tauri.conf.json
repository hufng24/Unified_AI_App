{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unified AI Workspace",
  "version": "0.1.0",
  "identifier": "com.hufng24.unifiedai",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Unified AI Workspace",
        "width": 1440,
        "height": 940,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#0B1020"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png"] }
}
